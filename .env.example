# Environment
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lexora_legaldesk
FRONTEND_URL=http://localhost:5173

# Security Secrets (Must be changed in production, min 32 characters)
ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
SESSION_COOKIE_NAME=lexora_rt
CSRF_COOKIE_NAME=lexora_csrf
ACCESS_COOKIE_NAME=lexora_at
COOKIE_SECURE=false

# ===================================================================
# Email Service Configuration (Brevo Recommended)
# ===================================================================
# Option 1: Brevo v3 Transactional API (Recommended - Works via HTTPS port 443)
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=notifications@yourchambers.com
BREVO_SENDER_NAME=Lexora LegalDesk

# Option 2: Brevo SMTP Relay / Generic SMTP (Alternative)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email@example.com
# SMTP_PASS=your-brevo-smtp-master-key
# MAIL_FROM=Lexora LegalDesk <notifications@yourchambers.com>

# Password Reset / Invitations Delivery Mode: 'brevo', 'smtp', or 'none' (dev mailbox)
PASSWORD_RESET_PROVIDER=brevo

# Initial Firm Bootstrap (Production Setup)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Practice Administrator
BOOTSTRAP_TEAM_NAME=Lexora Chambers
TIMEZONE=UTC
